{
  "name": "secondcut",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.firebase.config.ts",
    "build": "vite build --config vite.firebase.config.ts",
    "start": "vite preview --config vite.firebase.config.ts --host 127.0.0.1 --port 5180",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:model": "tsx scripts/validate-model.mjs",
    "dev:firebase": "vite --config vite.firebase.config.ts",
    "build:firebase": "vite build --config vite.firebase.config.ts",
    "deploy:firebase": "npm run deploy",
    "deploy": "npm run test && npm run typecheck && npm run build && firebase deploy --only hosting,firestore:rules --project kitproof --non-interactive",
    "test:firebase": "tsx scripts/test-firebase.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "firebase": "^12.4.0",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "firebase-tools": "^15.33.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "@eslint/js": "9.39.4",
    "typescript-eslint": "8.71.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^16.5.0"
  },
  "type": "module",
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "sharp": "0.35.5",
    "onnxruntime-node": {
      "global-agent": "4.1.3"
    },
    "basic-ftp": "6.2.3"
  }
}
