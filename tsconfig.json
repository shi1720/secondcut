{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "client",
    "app/studio.tsx",
    "components",
    "lib",
    "tests",
    "scripts/test-firebase.ts",
    "vite.firebase.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist-firebase"
  ]
}
